# Copy to .env and fill in. The worker reads only these.

# The action store: a Postgres where Verilays keeps its own table (created on first start).
VERILAYS_DSN=postgresql://verilays:verilays@postgres:5432/verilays

# One line per database your tools write to. @verilays.action.postgres(db="shop", ...)
# reads VERILAYS_POSTGRES_SHOP. A read-only user is enough.
VERILAYS_POSTGRES_SHOP=postgresql://readonly:password@your-db-host:5432/shop

# Optional: send each verdict to Langfuse as a score. Leave unset to turn it off.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
